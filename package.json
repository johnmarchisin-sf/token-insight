{
  "name": "token-insight",
  "version": "0.1.0",
  "description": "Token usage tracking, waste detection, and skill-candidate mining for Claude Code across all your workspaces.",
  "type": "module",
  "bin": {
    "ti": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/dashboard/public','dist/dashboard/public',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "dev:dashboard": "tsx src/cli.ts dashboard",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.19.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist",
    "src/dashboard/public"
  ]
}
